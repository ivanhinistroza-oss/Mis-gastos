<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/sinInternet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sin conexión"
            android:textColor="@color/texto"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            style="@style/Texto"
            android:gravity="center"
            android:text="La primera vez necesitas internet para ver tus gastos. Mientras tanto, los avisos de Yape y del banco se siguen guardando y se mandan solos." />
        <Button
            android:id="@+id/btnReintentarWeb"
            style="@style/Boton"
            android:layout_marginTop="20dp"
            android:text="Reintentar" />
    </LinearLayout>
</FrameLayout>
